# Copied to .env locally. EXPO_PUBLIC_* values are inlined when Metro bundles the app.
# For EAS Build, set the same keys in eas.json env or EAS Secrets per profile.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_GOOGLE_PLACES_KEY=
EXPO_PUBLIC_FOUNDER_TYPEFORM_URL=
EXPO_PUBLIC_VERIFICATION_ENABLED=false
# Legal pages (published on nospi.club)
EXPO_PUBLIC_TERMS_URL=https://nospi.club/terminos
EXPO_PUBLIC_PRIVACY_URL=https://nospi.club/privacidad
